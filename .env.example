# ==========================================
# Settle — environment variables
# Copy to .env and fill in real values
# ==========================================

# --- Application ---
APP_NAME=Settle
DEBUG=true

# --- Database ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=settle
POSTGRES_PASSWORD=settle_secret
POSTGRES_DB=settle

# --- JWT (RS256) ---
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Seed user (created on first startup) ---
SEED_USER_EMAIL=admin@settle.local
SEED_USER_PASSWORD=changeme

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- Logging ---
LOG_LEVEL=INFO
